<%- include('partials/header.ejs') %>

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow"><span class="live-dot"></span> YOUR NEXT FAVORITE STORY STARTS HERE</p>
        <h1>Find your next<br><span>great read.</span></h1>
        <p class="hero-description">Explore thousands of manga, discover new worlds, and pick up right where you left off.</p>
        <a class="button button-primary" href="#catalog">Explore manga <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero-art" aria-hidden="true">
        <div class="hero-orbit orbit-one"></div>
        <div class="hero-orbit orbit-two"></div>
        <div class="hero-book"><span>M</span><i></i><i></i><i></i></div>
        <div class="hero-star star-one">✦</div>
        <div class="hero-star star-two">✳</div>
    </div>
</section>

<% if (trending.length && userPreferences.showTrending) { %>
<section class="trending-section" data-trending-section aria-labelledby="trending-title">
    <div class="section-heading trending-heading">
        <div>
            <p class="eyebrow">TRENDING NOW</p>
            <h2 id="trending-title">Popular this moment</h2>
        </div>
        <a class="button button-secondary" href="/browse">Explore more <span aria-hidden="true">→</span></a>
    </div>
    <div class="trending-grid">
        <% trending.forEach((item, index) => { %>
            <article class="trending-card">
                <a class="trending-cover" href="/title/<%= item.id %>" aria-label="View <%= item.title %>">
                    <% if (item.cover) { %>
                        <img src="<%= item.cover %>" alt="Cover of <%= item.title %>" loading="lazy" referrerpolicy="no-referrer">
                    <% } else { %>
                        <span class="cover-placeholder"><%= item.title.slice(0, 1) %></span>
                    <% } %>
                    <span class="trending-rank">#<%= index + 1 %></span>
                </a>
                <p class="trending-meta"><%= item.status %><% if (item.year) { %><span>·</span><%= item.year %><% } %></p>
                <h3><a href="/title/<%= item.id %>"><%= item.title %></a></h3>
            </article>
        <% }) %>
    </div>
</section>
<% } %>

<% if (userPreferences.showContinueReading) { %>
<section class="home-reading-section" data-home-reading-section hidden aria-labelledby="home-reading-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">PICK UP WHERE YOU LEFT OFF</p>
            <h2 id="home-reading-title">Continue reading</h2>
        </div>
    </div>
    <div class="continue-reading-grid" data-home-reading-list></div>
</section>
<% } %>

<% if (currentUser && userPreferences.showBookmarkedUpdates) { %>
<section class="home-bookmarked-updates" data-home-bookmarks aria-labelledby="home-bookmarks-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">FROM YOUR BOOKMARKS</p>
            <h2 id="home-bookmarks-title">New chapters</h2>
        </div>
        <a class="button button-secondary" href="/bookmarks">All bookmarks <span aria-hidden="true">→</span></a>
    </div>
    <div class="bookmarked-updates-grid" data-home-bookmarks-grid></div>
    <div class="empty-state compact" data-home-bookmarks-empty hidden>
        <span class="empty-icon">♡</span>
        <h3>No bookmarked titles yet</h3>
        <p>Save a manga and its latest chapter will appear here.</p>
        <a class="button button-primary" href="/bookmarks">View bookmarks</a>
    </div>
</section>
<% } %>

<%- include('partials/manga-results.ejs') %>

<%- include('partials/footer.ejs') %>
