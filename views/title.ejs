<%- include('partials/header.ejs') %>

<a class="back-link" href="/">← Back to discovery</a>
<section class="title-hero">
    <div class="title-cover-wrap">
        <% if (manga.cover) { %>
            <img class="title-cover" src="<%= manga.cover %>" alt="Cover of <%= manga.title %>" referrerpolicy="no-referrer">
        <% } else { %>
            <div class="title-cover cover-placeholder"><span><%= manga.title.slice(0, 1) %></span></div>
        <% } %>
    </div>
    <div class="title-details">
        <p class="eyebrow"><%= manga.status.toUpperCase() %><%= manga.year ? ` · ${manga.year}` : '' %></p>
        <h1><%= manga.title %></h1>
        <div class="title-tags"><% manga.tags.forEach((tag) => { %><span><%= tag %></span><% }) %></div>
        <p class="title-description"><%= manga.description %></p>
        <div class="title-actions">
            <% if (chapters.length) { %>
                <a class="button button-primary" href="/read/<%= chapters[0].id %>" data-start-reading data-manga-id="<%= manga.id %>">Start reading <span aria-hidden="true">→</span></a>
            <% } else { %>
                <span class="button button-disabled">No English chapters available</span>
            <% } %>
            <% if (currentUser) { %>
                <div class="bookmark-dropdown" data-bookmark-dropdown>
                    <button class="button button-secondary bookmark-button-large" type="button" data-bookmark-id="<%= manga.id %>" data-bookmark-title="<%= manga.title %>" data-bookmark-cover="<%= manga.cover %>" data-bookmark-folder-menu-trigger aria-expanded="false" aria-controls="bookmark-folder-menu">
                        <span data-bookmark-label>＋ Add to library</span><span class="bookmark-dropdown-chevron" aria-hidden="true">⌄</span>
                    </button>
                    <div class="bookmark-folder-menu" id="bookmark-folder-menu" data-bookmark-folder-menu hidden role="group" aria-label="Choose a bookmark folder"></div>
                </div>
            <% } %>
        </div>
        <div class="title-stats">
            <div><span class="stat-value"><%= chapters.length %></span><span class="stat-label">Chapters loaded</span></div>
            <div><span class="stat-value"><%= manga.rating %></span><span class="stat-label">Content rating</span></div>
        </div>
    </div>
</section>

<section class="chapters-section">
    <div class="section-heading">
        <div><p class="eyebrow">THE STORY SO FAR</p><h2>Chapters</h2></div>
        <span class="chapter-count"><%= chapters.length %> available</span>
    </div>
    <% if (chapters.length) { %>
        <div class="chapter-list">
            <% chapters.slice().reverse().forEach((chapter) => { %>
                <a class="chapter-row" href="/read/<%= chapter.id %>" data-title-chapter-id="<%= chapter.id %>" data-title-chapter-index="<%= chapters.findIndex((item) => item.id === chapter.id) %>">
                    <span class="chapter-icon">▤</span>
                    <span class="chapter-main"><strong><%= chapter.label %></strong><small>Volume <%= chapter.volume || '—' %> · <%= chapter.group %></small></span>
                    <time><%= chapter.published ? new Date(chapter.published).toLocaleDateString() : '' %></time>
                    <span class="chapter-arrow" aria-hidden="true">→</span>
                </a>
            <% }) %>
        </div>
        <% if (chapters.length >= 100) { %><p class="chapter-note">Showing the latest 100 English chapters.</p><% } %>
    <% } else { %>
        <div class="empty-state compact"><h3>No English chapters available yet</h3><p>Chapter availability depends on MangaDex and its translation groups.</p></div>
    <% } %>
</section>

<%- include('partials/footer.ejs') %>
