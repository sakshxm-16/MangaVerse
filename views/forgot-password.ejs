<%- include('partials/header.ejs') %>

<section class="auth-page">
    <div class="auth-card">
        <p class="eyebrow">ACCOUNT RECOVERY</p>
        <h1>Forgot password?</h1>
        <p class="auth-intro">Enter the email address linked to your account and we'll send a reset link if it exists.</p>
        <% if (error) { %><p class="form-message form-message-error" role="alert"><%= error %></p><% } %>
        <% if (sent) { %>
            <p class="form-message form-message-success" role="status">If an account matches that email, a password reset link will arrive shortly. The link expires in one hour.</p>
        <% } else { %>
            <form class="account-form" action="/forgot-password" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label>
                    <span>Email</span>
                    <input type="email" name="email" maxlength="254" autocomplete="email" required>
                </label>
                <button class="button button-primary" type="submit">Send reset link</button>
            </form>
        <% } %>
        <p class="auth-switch"><a href="/login">Back to sign in</a></p>
    </div>
</section>

<%- include('partials/footer.ejs') %>
