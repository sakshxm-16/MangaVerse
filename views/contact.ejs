<%- include('partials/header.ejs') %>

<section class="contact-page">
    <p class="eyebrow">SUPPORT</p>
    <h1>Contact us</h1>
    <p class="contact-intro">Have a question or found a bug? Send us a message and we'll get back to you.</p>

    <div class="contact-card">
        <% if (error) { %><p class="form-message form-message-error" role="alert"><%= error %></p><% } %>
        <% if (sent) { %><p class="form-message form-message-success" role="status">Your message was sent. Thank you for getting in touch.</p><% } %>
        <form class="contact-form" action="/contact" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label>
                <span>Email</span>
                <input type="email" name="email" value="<%= email %>" maxlength="254" autocomplete="email" required>
            </label>
            <label>
                <span>Subject</span>
                <input type="text" name="subject" value="<%= subject %>" maxlength="120" required>
            </label>
            <label>
                <span>Message</span>
                <textarea name="message" maxlength="1000" required><%= message %></textarea>
            </label>
            <button class="button button-primary" type="submit">Send message</button>
        </form>
    </div>
</section>

<%- include('partials/footer.ejs') %>
